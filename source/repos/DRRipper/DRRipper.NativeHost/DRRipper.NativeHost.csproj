<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DRRipper.NativeHost</AssemblyName>
    <RootNamespace>DRRipper.NativeHost</RootNamespace>
    <!-- Self-contained single-file publish is a release-packaging choice;
         the committed build stays framework-dependent for CI speed. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DRRipper.BrowserProtocol\DRRipper.BrowserProtocol.csproj" />
  </ItemGroup>

</Project>
