<Window x:Class="DRRipper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:DRRipper.Views"
        Title="DRRipper" Height="640" Width="1100" MinWidth="760" MinHeight="480"
        Background="{StaticResource BackgroundPrimary}">
    <Window.Resources>
        <views:EnumMatchConverter x:Key="EnumMatch" />
        <views:BytesConverter x:Key="BytesConverter" />
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding AddCommand}" />
        <KeyBinding Key="F" Modifiers="Ctrl" Command="{Binding FocusSearchCommand}" />
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
    </Window.InputBindings>
    <DockPanel>
        <!-- TOP APP BAR (§6): identity + primary actions + aggregate speed -->
        <Border DockPanel.Dock="Top" Background="{StaticResource BackgroundSecondary}"
                BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="DRRipper" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                    <Button Content="Add Downloads  (Ctrl+N)" Margin="16,0,0,0"
                            Style="{StaticResource AccentButton}"
                            Command="{Binding AddCommand}"
                            ToolTip="Add downloads from URLs (Ctrl+N)" />
                    <Button Content="Pause All" Style="{StaticResource AppButton}"
                            Command="{Binding PauseAllCommand}" ToolTip="Pause all active jobs" />
                    <Button Content="Resume All" Style="{StaticResource AppButton}"
                            Command="{Binding ResumeAllCommand}" ToolTip="Resume all paused jobs" />
                    <Button Content="Settings" Style="{StaticResource AppButton}"
                            Click="SettingsButton_Click" ToolTip="Application settings" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding AggregateText, Mode=OneWay}" FontSize="14"
                               Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"
                               ToolTip="Aggregate throughput across active jobs (smoothed)" />
                    <TextBlock Margin="12,0,0,0" VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondary}"
                               Text="{Binding ActiveJobs, Mode=OneWay, StringFormat={}{0} active}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- BOTTOM STATUS BAR (§40) -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock>
                    <Run Text="Total " /><Run Text="{Binding TotalJobs, Mode=OneWay}" />
                    <Run Text="  •  Queued " /><Run Text="{Binding QueuedJobs, Mode=OneWay}" />
                    <Run Text="  •  Completed " /><Run Text="{Binding CompletedJobs, Mode=OneWay}" />
                    <Run Text="  •  Failed " /><Run Text="{Binding FailedJobs, Mode=OneWay}" />
                </TextBlock>
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="{Binding AggregateText, Mode=OneWay}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="{Binding PermitsText, Mode=OneWay}"
                           ToolTip="Global transfer-permit usage (scheduler budget)" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem HorizontalContentAlignment="Stretch">
                <TextBlock Text="{Binding StatusText, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
            </StatusBarItem>
        </StatusBar>

        <!-- Shutdown veil (§27): bounded "Saving download state…" instead of a freeze -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Warning}" Padding="12,6"
                Visibility="{Binding IsShuttingDown, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="Saving download state… DRRipper will close momentarily. Partial files are preserved."
                       Foreground="Black" FontWeight="Bold" />
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT FILTER SIDEBAR (§6/§11) -->
            <Border Background="{StaticResource BackgroundSecondary}"
                    BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
                <StackPanel Margin="6">
                    <TextBlock Text="QUEUE" Margin="4,4,4,8" FontWeight="Bold"
                               Foreground="{StaticResource TextSecondary}" FontSize="11" />
                    <RadioButton Content="All" GroupName="QueueFilter" Style="{StaticResource ToolbarToggle}"
                                 IsChecked="{Binding Filter, Converter={StaticResource EnumMatch}, ConverterParameter=All, Mode=TwoWay}" />
                    <RadioButton Content="Active" GroupName="QueueFilter" Style="{StaticResource ToolbarToggle}"
                                 IsChecked="{Binding Filter, Converter={StaticResource EnumMatch}, ConverterParameter=Active, Mode=TwoWay}" />
                    <RadioButton Content="Queued" GroupName="QueueFilter" Style="{StaticResource ToolbarToggle}"
                                 IsChecked="{Binding Filter, Converter={StaticResource EnumMatch}, ConverterParameter=Queued, Mode=TwoWay}" />
                    <RadioButton Content="Paused" GroupName="QueueFilter" Style="{StaticResource ToolbarToggle}"
                                 IsChecked="{Binding Filter, Converter={StaticResource EnumMatch}, ConverterParameter=Paused, Mode=TwoWay}" />
                    <RadioButton Content="Completed" GroupName="QueueFilter" Style="{StaticResource ToolbarToggle}"
                                 IsChecked="{Binding Filter, Converter={StaticResource EnumMatch}, ConverterParameter=Completed, Mode=TwoWay}" />
                    <RadioButton Content="Failed" GroupName="QueueFilter" Style="{StaticResource ToolbarToggle}"
                                 IsChecked="{Binding Filter, Converter={StaticResource EnumMatch}, ConverterParameter=Failed, Mode=TwoWay}" />
                    <RadioButton Content="Cancelled" GroupName="QueueFilter" Style="{StaticResource ToolbarToggle}"
                                 IsChecked="{Binding Filter, Converter={StaticResource EnumMatch}, ConverterParameter=Cancelled, Mode=TwoWay}" />
                </StackPanel>
            </Border>

            <!-- MAIN CONTENT -->
            <Grid Grid.Column="1" Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchBox" Height="28"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Search filename, URL, host, status, path (Ctrl+F)" />
                    <TextBlock Grid.Column="0" Margin="8,0,0,0" VerticalAlignment="Center"
                               Foreground="{StaticResource Muted}" IsHitTestVisible="False"
                               Text="Search queue…  (Ctrl+F)">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button Grid.Column="1" Content="Refresh (F5)" Margin="8,0,0,0"
                            Style="{StaticResource AppButton}" Command="{Binding RefreshCommand}" />
                </Grid>

                <!-- Horizontal scroll keeps every action reachable at minimum width (§20);
                     the DataGrid below is intentionally NOT wrapped (virtualization). -->
                <ScrollViewer Grid.Row="1" Margin="0,8,0,0"
                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal">
                    <Button Content="Pause" Style="{StaticResource AppButton}"
                            Command="{Binding PauseSelectedCommand}" ToolTip="Pause selected (Space toggles)" />
                    <Button Content="Resume" Style="{StaticResource AppButton}"
                            Command="{Binding ResumeSelectedCommand}" ToolTip="Resume selected" />
                    <Button Content="Cancel" Style="{StaticResource AppButton}"
                            Command="{Binding CancelSelectedCommand}" ToolTip="Cancel selected (drops partials)" />
                    <Button Content="Retry" Style="{StaticResource AppButton}"
                            Command="{Binding RetrySelectedCommand}" ToolTip="Retry failed/cancelled selected" />
                    <Button Content="Remove (Del)" Style="{StaticResource AppButton}"
                            Command="{Binding RemoveSelectedCommand}" ToolTip="Remove selected (keeps completed files)" />
                    <Button Content="▲" Style="{StaticResource AppButton}"
                            Command="{Binding MoveUpCommand}" ToolTip="Move selected up in queue order" />
                    <Button Content="▼" Style="{StaticResource AppButton}"
                            Command="{Binding MoveDownCommand}" ToolTip="Move selected down in queue order" />
                    <Button Content="Clear Done" Style="{StaticResource AppButton}"
                            Command="{Binding ClearDoneCommand}" ToolTip="Remove completed/failed/cancelled entries" />
                </StackPanel>
                </ScrollViewer>

                <!-- VIRTUALIZED JOB TABLE (§7/§22): no ScrollViewer wrapper, Recycling mode -->
                <DataGrid x:Name="QueueGrid" Grid.Row="2" Margin="0,8,0,0"
                          ItemsSource="{Binding VisibleJobs}"
                          Style="{StaticResource QueueDataGrid}"
                          ColumnHeaderStyle="{StaticResource QueueColumnHeader}"
                          CanUserSortColumns="True" Sorting="QueueGrid_Sorting"
                          SelectionChanged="QueueGrid_SelectionChanged">
                    <DataGrid.InputBindings>
                        <KeyBinding Key="Delete" Command="{Binding RemoveSelectedCommand}" />
                        <KeyBinding Key="Space" Command="{Binding TogglePauseResumeCommand}" />
                    </DataGrid.InputBindings>
                    <DataGrid.ContextMenu>
                        <!-- Popup-tree DataContext fix (Ticket #006.1 §3): popups do NOT
                             inherit DataContext, so bind explicitly to the placement target. -->
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="Pause" Command="{Binding PauseSelectedCommand}" />
                            <MenuItem Header="Resume" Command="{Binding ResumeSelectedCommand}" />
                            <MenuItem Header="Cancel" Command="{Binding CancelSelectedCommand}" />
                            <MenuItem Header="Retry" Command="{Binding RetrySelectedCommand}" />
                            <Separator />
                            <MenuItem Header="Open File" Command="{Binding OpenFileCommand}" />
                            <MenuItem Header="Open Folder" Command="{Binding OpenFolderCommand}" />
                            <MenuItem Header="Copy URL" Command="{Binding CopyUrlCommand}" />
                            <MenuItem Header="Copy File Path" Command="{Binding CopyPathCommand}" />
                            <Separator />
                            <MenuItem Header="Move Up" Command="{Binding MoveUpCommand}" />
                            <MenuItem Header="Move Down" Command="{Binding MoveDownCommand}" />
                            <MenuItem Header="Move To Top" Command="{Binding MoveTopCommand}" />
                            <MenuItem Header="Move To Bottom" Command="{Binding MoveBottomCommand}" />
                            <Separator />
                            <MenuItem Header="Remove" Command="{Binding RemoveSelectedCommand}" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Status" Width="170" SortMemberPath="State"
                                                CellTemplate="{StaticResource StatusCellTemplate}" />
                        <DataGridTextColumn Header="Name" Width="220" Binding="{Binding FileName}" />
                        <DataGridTemplateColumn Header="Progress" Width="150" SortMemberPath="Progress"
                                                CellTemplate="{StaticResource ProgressCellTemplate}" />
                        <DataGridTextColumn Header="Downloaded" Width="130" Binding="{Binding BytesText}" />
                        <DataGridTextColumn Header="Size" Width="90" Binding="{Binding TotalBytes, Converter={StaticResource BytesConverter}}" />
                        <DataGridTextColumn Header="Speed" Width="90" Binding="{Binding SpeedText}" SortMemberPath="SpeedMBps" />
                        <DataGridTextColumn Header="ETA" Width="80" Binding="{Binding EtaText}" />
                        <DataGridTextColumn Header="Host" Width="150" Binding="{Binding Host}" />
                        <DataGridTextColumn Header="Conns" Width="60" Binding="{Binding Connections}" />
                        <DataGridTextColumn Header="Added" Width="130" Binding="{Binding Added, StringFormat={}{0:yyyy-MM-dd HH:mm}}" SortMemberPath="Added" />
                        <DataGridTextColumn Header="Path" Width="220" Binding="{Binding TargetPath}" />
                    </DataGrid.Columns>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="ToolTip" Value="{Binding FailureReason}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding State}" Value="Failed">
                                    <Setter Property="Foreground" Value="{StaticResource Error}" />
                                    <Setter Property="ToolTip" Value="{Binding FailureReason}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="Completed">
                                    <Setter Property="Foreground" Value="{StaticResource Success}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                </DataGrid>

                <!-- OPTIONAL DETAILS PANE (§41): first selected row, collapsible -->
                <Expander Grid.Row="3" Margin="0,8,0,0" Header="Details" IsExpanded="False">
                    <Grid DataContext="{Binding SelectedItem, ElementName=QueueGrid}" Margin="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="URL:" Foreground="{StaticResource TextSecondary}" />
                        <TextBlock Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding Url}" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Url}" Foreground="{StaticResource TextPrimary}" />
                        <TextBlock Grid.Row="1" Text="Host:" Foreground="{StaticResource TextSecondary}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Host}" Foreground="{StaticResource TextPrimary}" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Connections:" Foreground="{StaticResource TextSecondary}" />
                        <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding Connections}" Foreground="{StaticResource TextPrimary}" />
                        <TextBlock Grid.Row="2" Text="Target:" Foreground="{StaticResource TextSecondary}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding TargetPath}" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding TargetPath}" Foreground="{StaticResource TextPrimary}" />
                        <TextBlock Grid.Row="3" Text="Failure:" Foreground="{StaticResource TextSecondary}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding FailureReason}" TextWrapping="Wrap"
                                   Foreground="{StaticResource Error}" />
                    </Grid>
                </Expander>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
