<Window x:Class="DRRipper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DRRipper" Height="560" Width="900" MinWidth="700" MinHeight="440"
        Background="#1E1E1E">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="80" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="120" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="URLs (one per line):" Foreground="LightGray" Grid.Row="0" />
        <TextBox x:Name="UrlTextBox" Grid.Row="1" Margin="0,6,0,0" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Foreground="White" Background="#2D2D30" BorderBrush="#3C3C3C" />

        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Save To:" Foreground="LightGray" VerticalAlignment="Center" />
            <TextBox x:Name="PathTextBox" Grid.Column="1" Margin="8,0,8,0" Height="28" Foreground="White" Background="#2D2D30" BorderBrush="#3C3C3C" />
            <Button x:Name="BrowseButton" Grid.Column="2" Content="Browse..." Height="28" Width="84" Click="BrowseButton_Click" />
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
            <Button x:Name="AddButton" Content="Add / Start" Height="30" Width="110" Click="AddButton_Click" />
            <Button x:Name="PauseResumeButton" Content="Pause" Height="30" Width="90" Margin="8,0,0,0" Click="PauseResumeButton_Click" />
            <Button x:Name="CancelJobButton" Content="Cancel" Height="30" Width="80" Margin="8,0,0,0" Click="CancelJobButton_Click" />
            <Button x:Name="RetryButton" Content="Retry" Height="30" Width="70" Margin="8,0,0,0" Click="RetryButton_Click" />
            <Button x:Name="RemoveButton" Content="Remove" Height="30" Width="80" Margin="8,0,0,0" Click="RemoveButton_Click" />
            <Button x:Name="PauseAllButton" Content="Pause All" Height="30" Width="84" Margin="16,0,0,0" Click="PauseAllButton_Click" />
            <Button x:Name="ResumeAllButton" Content="Resume All" Height="30" Width="90" Margin="8,0,0,0" Click="ResumeAllButton_Click" />
            <Button x:Name="ClearDoneButton" Content="Clear Done" Height="30" Width="84" Margin="8,0,0,0" Click="ClearDoneButton_Click" />
        </StackPanel>

        <ListView x:Name="QueueListView" Grid.Row="4" Margin="0,12,0,0" Background="#2D2D30" BorderBrush="#3C3C3C" Foreground="White"
                  SelectionMode="Extended" SelectionChanged="QueueListView_SelectionChanged">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="File" Width="220" DisplayMemberBinding="{Binding DisplayName}" />
                    <GridViewColumn Header="Status" Width="170" DisplayMemberBinding="{Binding Status}" />
                    <GridViewColumn Header="Progress" Width="80" DisplayMemberBinding="{Binding Progress, StringFormat={}{0:F1}%}" />
                    <GridViewColumn Header="Bytes" Width="170" DisplayMemberBinding="{Binding Bytes}" />
                    <GridViewColumn Header="Speed" Width="90" DisplayMemberBinding="{Binding Speed}" />
                </GridView>
            </ListView.View>
        </ListView>

        <Grid Grid.Row="5" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Queue:" Foreground="LightGray" VerticalAlignment="Center" />
                <TextBlock x:Name="QueueSummaryLabel" Text="0 jobs" Foreground="White" Margin="6,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock x:Name="StateLabel" Grid.Column="1" Text="Idle" Foreground="White" Margin="12,0,0,0"
                       HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Window>
