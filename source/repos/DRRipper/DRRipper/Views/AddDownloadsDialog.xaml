<Window x:Class="DRRipper.Views.AddDownloadsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Downloads" Height="480" Width="620" MinWidth="480" MinHeight="380"
        Background="{StaticResource BackgroundPrimary}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="URLs (one per line):" Foreground="{StaticResource TextSecondary}" />
        <TextBox Grid.Row="1" Margin="0,6,0,0" MinHeight="120"
                 Text="{Binding UrlsText, UpdateSourceTrigger=PropertyChanged}"
                 AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" AcceptsTab="False" />

        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Save to:" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Margin="8,0,8,0" Height="28"
                     Text="{Binding TargetDirectory, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Column="2" Content="Browse..." Height="28" Width="84"
                    Style="{StaticResource AppButton}" Click="BrowseButton_Click" />
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
            <TextBlock Text="Connections:" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
            <ComboBox Margin="8,0,16,0" Width="64" x:Name="ConnectionsBox"
                      SelectionChanged="ConnectionsBox_SelectionChanged" Loaded="ConnectionsBox_Loaded">
                <ComboBoxItem Content="1" /><ComboBoxItem Content="2" />
                <ComboBoxItem Content="4" /><ComboBoxItem Content="8" />
                <ComboBoxItem Content="16" />
            </ComboBox>
            <TextBlock Text="Priority:" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
            <ComboBox Margin="8,0,0,0" Width="64"
                      SelectionChanged="PriorityBox_SelectionChanged">
                <ComboBoxItem Content="0" /><ComboBoxItem Content="1" />
                <ComboBoxItem Content="2" /><ComboBoxItem Content="5" />
            </ComboBox>
        </StackPanel>

        <StackPanel Grid.Row="4" Margin="0,8,0,0">
            <TextBlock Foreground="{StaticResource TextSecondary}">
                <Run Text="Accepted: " /><Run Text="{Binding Accepted, Mode=OneWay}" />
                <Run Text="   Rejected: " /><Run Text="{Binding Rejected, Mode=OneWay}" />
            </TextBlock>
            <ListBox MaxHeight="90" Margin="0,4,0,0"
                     ItemsSource="{Binding Errors, Mode=OneWay}"
                     Background="{StaticResource Surface}"
                     Foreground="{StaticResource TextSecondary}"
                     BorderBrush="{StaticResource Border}" />
        </StackPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,12,0,0" HorizontalAlignment="Right">
            <Button Content="Add to Queue" Height="30" Width="120" Style="{StaticResource AppButton}" Click="AddButton_Click" />
            <Button Content="Add and Start" Height="30" Width="120" Style="{StaticResource AccentButton}"
                    ToolTip="Adds the URLs and ensures the queue is admitting jobs."
                    Click="AddStartButton_Click" />
            <Button Content="Cancel" Height="30" Width="84" Style="{StaticResource AppButton}" Click="CancelButton_Click" />
        </StackPanel>
    </Grid>
</Window>
