<Window x:Class="DRRipper.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Height="540" Width="520" MinWidth="440" MinHeight="400"
        Background="{StaticResource BackgroundPrimary}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Scrollable so the dialog fits at 125/150% scaling (§22). -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <TextBlock Text="Downloads" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" Margin="0,0,0,8" />
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Active downloads (live):" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,4" />
                <ComboBox Grid.Column="1" Margin="0,4" Width="80" HorizontalAlignment="Left"
                          SelectionChanged="ActiveBox_SelectionChanged" Loaded="ActiveBox_Loaded">
                    <ComboBoxItem Content="1" /><ComboBoxItem Content="2" />
                    <ComboBoxItem Content="3" /><ComboBoxItem Content="4" />
                    <ComboBoxItem Content="8" />
                </ComboBox>
                <TextBlock Grid.Row="1" Text="Connections per file:" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,4" />
                <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,4" Width="80" HorizontalAlignment="Left"
                          SelectionChanged="ConnsBox_SelectionChanged" Loaded="ConnsBox_Loaded">
                    <ComboBoxItem Content="1" /><ComboBoxItem Content="2" />
                    <ComboBoxItem Content="4" /><ComboBoxItem Content="8" />
                    <ComboBoxItem Content="16" />
                </ComboBox>
                <TextBlock Grid.Row="2" Text="Default folder:" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,4" />
                <Grid Grid.Row="2" Grid.Column="1" Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding DefaultDownloadDirectory, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Column="1" Content="Browse..." Margin="6,0,0,0" Style="{StaticResource AppButton}" Click="BrowseButton_Click" />
                </Grid>
                <TextBlock Grid.Row="3" Text="UI refresh (ms):" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,4" />
                <ComboBox Grid.Row="3" Grid.Column="1" Margin="0,4" Width="80" HorizontalAlignment="Left"
                          SelectionChanged="RefreshBox_SelectionChanged" Loaded="RefreshBox_Loaded">
                    <ComboBoxItem Content="250" /><ComboBoxItem Content="500" />
                    <ComboBoxItem Content="1000" /><ComboBoxItem Content="2000" />
                </ComboBox>
            </Grid>

            <TextBlock Text="Connection budgets (restart required)" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" Margin="0,12,0,8" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Global budget:" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,4" />
                <ComboBox Grid.Column="1" Margin="0,4" Width="80" HorizontalAlignment="Left"
                          SelectionChanged="GlobalBox_SelectionChanged" Loaded="GlobalBox_Loaded">
                    <ComboBoxItem Content="8" /><ComboBoxItem Content="16" />
                    <ComboBoxItem Content="32" /><ComboBoxItem Content="64" />
                </ComboBox>
                <TextBlock Grid.Row="1" Text="Per-host budget:" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,4" />
                <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,4" Width="80" HorizontalAlignment="Left"
                          SelectionChanged="HostBox_SelectionChanged" Loaded="HostBox_Loaded">
                    <ComboBoxItem Content="2" /><ComboBoxItem Content="4" />
                    <ComboBoxItem Content="8" /><ComboBoxItem Content="16" />
                </ComboBox>
            </Grid>
            <CheckBox Margin="0,12,0,0" Foreground="{StaticResource TextSecondary}"
                      IsChecked="{Binding RememberWindowPlacement}"
                      Content="Remember window size and position" />

            <TextBlock Text="Desktop behavior" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" Margin="0,12,0,8" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Close button:" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,4"
                           ToolTip="What the window X button does." />
                <ComboBox Grid.Column="1" Margin="0,4" Width="170" HorizontalAlignment="Left"
                          SelectionChanged="CloseBox_SelectionChanged" Loaded="CloseBox_Loaded"
                          ToolTip="Hide to tray: X never stops downloads. Exit when idle: X exits only with nothing active. Always exit: X always shuts down.">
                    <ComboBoxItem Content="Hide to tray" />
                    <ComboBoxItem Content="Exit when idle" />
                    <ComboBoxItem Content="Always exit" />
                </ComboBox>
                <CheckBox Grid.Row="1" Grid.ColumnSpan="2" Margin="0,6,0,0" Foreground="{StaticResource TextSecondary}"
                          IsChecked="{Binding MinimizeToTray}"
                          Content="Minimize to tray (minimizing hides the window, downloads continue)"
                          ToolTip="When checked, the minimize button hides DRRipper to the tray instead of the taskbar." />
            </Grid>

            <TextBlock Margin="0,12,0,0" Foreground="{StaticResource Warning}" FontSize="11"
                       Text="Connection budget changes take effect after restarting DRRipper. Active-download limit, connections, folder, and refresh apply immediately." TextWrapping="Wrap" />

            <TextBlock Text="Browser integration" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" Margin="0,12,0,8" />
            <!-- Browser panel gets its own VM in code-behind (Ticket #007 §24). -->
            <StackPanel x:Name="BrowserPanel" Loaded="BrowserPanel_Loaded">
                <TextBlock Foreground="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap"
                           Text="Send ordinary downloads from Chrome/Edge/Firefox to DRRipper. Install registers the native host (per-user, reversible); nothing changes until you press Install." />
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Chrome:" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,4" />
                    <TextBlock Grid.Column="1" Text="{Binding ChromeStatus}" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" Margin="0,4" TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="2" Content="Install" Margin="4,2" Style="{StaticResource AppButton}" Click="BrowserInstall_Click" Tag="Chrome" />
                    <Button Grid.Column="3" Content="Remove" Margin="0,2" Style="{StaticResource AppButton}" Click="BrowserUninstall_Click" Tag="Chrome" />
                    <TextBlock Grid.Row="1" Text="Edge:" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,4" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding EdgeStatus}" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" Margin="0,4" TextTrimming="CharacterEllipsis" />
                    <Button Grid.Row="1" Grid.Column="2" Content="Install" Margin="4,2" Style="{StaticResource AppButton}" Click="BrowserInstall_Click" Tag="Edge" />
                    <Button Grid.Row="1" Grid.Column="3" Content="Remove" Margin="0,2" Style="{StaticResource AppButton}" Click="BrowserUninstall_Click" Tag="Edge" />
                    <TextBlock Grid.Row="2" Text="Firefox:" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,4" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding FirefoxStatus}" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" Margin="0,4" TextTrimming="CharacterEllipsis" />
                    <Button Grid.Row="2" Grid.Column="2" Content="Install" Margin="4,2" Style="{StaticResource AppButton}" Click="BrowserInstall_Click" Tag="Firefox" />
                    <Button Grid.Row="2" Grid.Column="3" Content="Remove" Margin="0,2" Style="{StaticResource AppButton}" Click="BrowserUninstall_Click" Tag="Firefox" />
                    <TextBlock Grid.Row="3" Text="Extension ID:" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,4"
                               ToolTip="From the browser's extension page after loading the unpacked extension (see browser-extension/README.md)." />
                    <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,4"
                             Text="{Binding ExtensionId, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Paste the extension ID shown on chrome://extensions (Developer mode) after loading the unpacked extension." />
                    <StackPanel Grid.Row="4" Grid.ColumnSpan="4" Orientation="Horizontal" Margin="0,4,0,0">
                        <Button Content="Refresh status" Style="{StaticResource AppButton}" Click="BrowserRefresh_Click" />
                        <Button Content="Test connection" Margin="6,0,0,0" Style="{StaticResource AppButton}" Click="BrowserTest_Click" />
                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" FontSize="11"
                                   Text="{Binding BridgeStatus}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
                <TextBlock Margin="0,6,0,0" Foreground="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap"
                           Text="{Binding Diagnostics}" />
            </StackPanel>
        </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Save" Height="30" Width="100" Style="{StaticResource AccentButton}" Click="SaveButton_Click" />
            <Button Content="Cancel" Height="30" Width="84" Style="{StaticResource AppButton}" Click="CancelButton_Click" />
        </StackPanel>
    </Grid>
</Window>
