<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Semantic palette (Ticket #006 §38): restrained dark desktop, single restrained accent. -->
    <Color x:Key="BackgroundPrimaryColor">#1E1E1E</Color>
    <Color x:Key="BackgroundSecondaryColor">#252526</Color>
    <Color x:Key="SurfaceColor">#2D2D30</Color>
    <Color x:Key="SurfaceHoverColor">#3A3A3D</Color>
    <Color x:Key="BorderColor">#3C3C3C</Color>
    <Color x:Key="TextPrimaryColor">#F1F1F1</Color>
    <Color x:Key="TextSecondaryColor">#9D9D9D</Color>
    <Color x:Key="AccentColor">#4E94CE</Color>
    <Color x:Key="SuccessColor">#7FB069</Color>
    <Color x:Key="WarningColor">#D8A24A</Color>
    <Color x:Key="ErrorColor">#D0605A</Color>
    <Color x:Key="MutedColor">#6E6E6E</Color>

    <SolidColorBrush x:Key="BackgroundPrimary" Color="{StaticResource BackgroundPrimaryColor}" />
    <SolidColorBrush x:Key="BackgroundSecondary" Color="{StaticResource BackgroundSecondaryColor}" />
    <SolidColorBrush x:Key="Surface" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceHover" Color="{StaticResource SurfaceHoverColor}" />
    <SolidColorBrush x:Key="Border" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="TextPrimary" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondary" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="Success" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="Warning" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="Error" Color="{StaticResource ErrorColor}" />
    <SolidColorBrush x:Key="Muted" Color="{StaticResource MutedColor}" />
</ResourceDictionary>
