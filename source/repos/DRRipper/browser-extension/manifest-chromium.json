{
  "manifest_version": 3,
  "name": "DRRipper Download Handoff",
  "version": "0.7.0",
  "description": "Send ordinary downloads to the DRRipper desktop app.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/dripper-16.png",
    "48": "icons/dripper-48.png",
    "128": "icons/dripper-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "permissions": [
    "contextMenus",
    "downloads",
    "nativeMessaging",
    "storage"
  ]
}
